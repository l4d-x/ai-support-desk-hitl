# Copy to .env and fill in. NEVER commit the real .env file.

# --- LLM (https://console.groq.com) ---
GROQ_API_KEY=

# Groq retired llama-3.3-70b-versatile. These are the defaults; override if Groq changes again.
LLM_MODEL=openai/gpt-oss-120b
# Used only by the eval harness, deliberately a different model family from LLM_MODEL.
JUDGE_MODEL=qwen/qwen3.8-27b

# --- Vector DB ---
# Qdrant Cloud URL + key. Leave both empty to use an in-memory Qdrant
# (re-indexed from kb/*.md on every start) -- fine for dev, tests and CI.
QDRANT_URL=
QDRANT_API_KEY=

# --- API behaviour ---
# Cosine similarity of the top KB hit below which a ticket goes to a human.
# 0.50 was chosen on the eval dev split (see eval/results.md); the old 0.75 auto-resolved ~0% of tickets.
CONFIDENCE_THRESHOLD=0.50
# Where the markdown knowledge base lives (default: ./kb)
KB_DIR=kb
# SQLite file for sample orders (dev fallback; replaced by Postgres in prod)
ORDERS_DB_PATH=data/orders.db

# --- Frontend ---
# URL of the FastAPI backend, used by the Streamlit app
API_URL=http://localhost:8000

# Screens would-be auto-sent tickets for prompt injection (extra Groq call). Set false to disable.
INJECTION_GUARD_ENABLED=true
